# Copy to .env and adjust. Every value has a working default in
# coffee_leaf/config.py, so an empty environment is fine for local use.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Model ----------------------------------------------------------------
# Trained checkpoint. A sibling .onnx export is preferred automatically when
# present (faster on CPU, no torch in the request path).
MODEL_PATH=models/best.pt

# --- Inference ------------------------------------------------------------
CONF_THRESHOLD=0.25
JPEG_QUALITY=85
# Refuse to decode images above this pixel count (decompression-bomb guard).
MAX_IMAGE_PIXELS=40000000

# --- Uploads --------------------------------------------------------------
MAX_CONTENT_LENGTH=10485760
MAX_BATCH_FILES=8

# --- Storage & rate limiting ---------------------------------------------
DATABASE_PATH=instance/app.sqlite3
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# --- Optional: raise this for a released build ----------------------------
# APP_VERSION=2.1.0
